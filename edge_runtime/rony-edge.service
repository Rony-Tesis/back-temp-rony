[Unit]
Description=Rony autonomous YOLO and classification on JetMax
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=hiwonder
WorkingDirectory=/home/hiwonder
EnvironmentFile=/etc/rony-edge/edge.env
ExecStart=/bin/bash -ic 'exec /opt/rony-edge/start.sh'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
