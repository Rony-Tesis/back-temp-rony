[Unit]
Description=Rony JetMax local trajectory executor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=hiwonder
WorkingDirectory=/home/hiwonder
EnvironmentFile=/etc/rony-agent/agent.env
ExecStart=/bin/bash -ic 'exec /opt/rony-agent/start.sh'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
